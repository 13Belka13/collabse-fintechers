# Copy to .env (gitignored). Testnet only — Base Sepolia (eip155:84532). Names follow SPEC §16.

# AI (fill at the AWS Toolbox)
# Hackathon account (AWS Participant Guide): build in eu-central-1; Claude 4.5 only, via EU inference profiles.
AWS_REGION=eu-central-1
# Credentials, one of:
#  1) temporary keys from https://d-c3676ff6eb.awsapps.com/start -> your account -> Access keys (valid 12 h)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
#  2) an SSO profile: aws configure sso (SSO region eu-north-1, client region eu-central-1), aws sso login
AWS_PROFILE=                # e.g. hackathon
#  3) a short-term Bedrock API key from the console
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_CLIENT=invoke       # invoke = AnthropicBedrock (InvokeModel); mantle = AnthropicBedrockMantle
MODEL_MAIN=eu.anthropic.claude-opus-4-5-20251101-v1:0     # or eu.anthropic.claude-sonnet-4-5-20250929-v1:0
MODEL_FAST=eu.anthropic.claude-haiku-4-5-20251001-v1:0    # Claude 4.5 takes no output_config.effort
MOCK=1                      # 1 = scripted LLM replies (offline dev / stage fallback)
# Bedrock timeouts (defaults shown; they nest: seller model 20 s < bank -> seller 30 s < agent -> bank 45 s)
LLM_CONNECT_S=5             # per attempt
LLM_READ_S_MAIN=60          # per attempt, capped by the stage budget
LLM_READ_S_FAST=30
LLM_RETRIES=2               # extra attempts on throttling / 5xx / timeouts / connection errors, never on 4xx
LLM_BUDGET_S_SELLER=20      # wall clock per seller turn, then the code-written reply
NEGOTIATE_TIMEOUT_S=30      # bank -> seller /negotiate
BANK_HTTP_TIMEOUT_S=45      # agent -> bank API

# Mandate
CZK_PER_EUR_DEMO=25         # tCZK -> EUR for mandate limits; shown on screen as a demo rate

# Validation runs (scripts/scenarios.py only)
SCENARIO_PRICE_EUR=0.10     # small amounts for the testnet scenario matrix
FAULTS=                     # comma list: settle_fail_once,registry_timeout,llm_bad_json,webhook_duplicate,webhook_bad_hmac,
                            # llm_slow,llm_timeout,llm_throttle,llm_throttle_once,llm_error,llm_expired,llm_refusal
                            # (an llm_* fault takes @stage: llm_timeout@seller, @buyer, @criteria, @explain)
LLM_FAULT_SLOW_S=8          # FAULTS=llm_slow: every model answer comes this late

# Chain
RPC_URL=https://base-sepolia.gateway.tatum.io      # header x-api-key = TATUM_API_KEY; public fallback https://sepolia.base.org
TATUM_API_KEY=
TATUM_HMAC_SECRET=
PUBLIC_BASE_URL=            # https://<tunnel> for Tatum webhooks

# Keys (throwaway testnet; copy from prep spikes .env, never commit)
BANK_RELAYER_PK=            # = prep BANK_KEY   (0xD23DB197CC1294b049AeDf0d9ea1BA216691de48, has ETH)
BANK_ADMIN_PK=              # = prep BANK_KEY   (deployer/admin of tCZK)
BANK_OPERATOR_PK=           # = prep OPERATOR_KEY (0x0469ceC178789072bc61435835D0BB38214D4e53, has ETH)
ALFA_PK=                    # = prep BUYER_KEY  (0x491BeCCB4E26E1c5781E1E44c48Ad474D04d2140: USDC, EURC, prep tCZK)
BETA_ADDR=0x70E8B0ed46DC4FD558ee05bCEba06e5AAf00EBd1
GAMA_ADDR=                  # generate
DELTA_ADDR=                 # generate

# Contracts / tokens
EURC=0x808456652fdb597867f38412077A9182bf77359F
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
TCZK=                       # new TCZK after T3; stage fallback: prep token 0x6a99C9e95DD220172d07D5f730f2e82B466D4B67
TCZK_NAME="tCZK Deposit Token"   # EIP-712 name, must match TCZK; prep token: "Demo Bank tCZK"
ESCROW=0xf96815976523E00e65Be8f34cA5e64b4f41EB19c
COLLECTOR=0x8612dfdc421f80336cd14E8EF9cb1E765dB5ab88
OPERATOR_TOKEN_STORE=0xd2b0C305F62427414e9624a2beD72a3792e15cf8

# Services
BANK_FACILITATOR_URL=http://localhost:8000/x402
PUBLIC_FACILITATOR_URL=https://x402.org/facilitator   # EURC fallback only
SELLER_URL=http://localhost:8001

# Data
APIFY_TOKEN=
APIFY_COMPANY_CHECK_ACTOR=savvy_sauger/company-check   # <apify-username>/company-check after `apify push`
MOSTLYRIGHT_API_KEY=        # how to get: ask at onboarding

# Auth between the parts (prototype shared secrets; dev defaults are used when empty — set real ones for the demo)
AGENT_TOKEN_ALFA=           # buyer agent of Alfa -> bank API (the token decides whose money it may spend)
SELLER_TOKEN=               # seller service -> bank (deliveries only)
BANK_TO_SELLER_TOKEN=       # bank -> seller (escrow notices only)
HUMAN_TOKEN=                # bank UI -> confirmations above the threshold, VAT-risk acknowledgements
BANK_OPERATOR_ADDR=         # escrow operator the seller accepts; derived from BANK_OPERATOR_PK when empty

# Seller service pricing (seller/app.py). Leave both empty for tests and scripts.
SELLER_OPENING=             # "list" for the demo: open at 6,00 € for 20 items, the AI seller haggles down to 5,00 € in ≤ 3 turns
SELLER_PRICE_PER_ITEM_EUR_CENTS=   # fixed price per item, no haggling (small live runs: 1 = 0,01 €)
SELLER_DATA=                # "maps": deliver the real Brno places recorded via Apify; empty: the synthetic set

# Incoming-transfer poll when Tatum cannot reach us (no PUBLIC_BASE_URL): 3 RPC calls per tick
BANK_POLL_S=                # seconds between polls (default 1; e.g. 10 when idle, to save Tatum credits)
BANK_POLLER=                # 0 switches the poller off
