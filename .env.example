# Copy to .env (gitignored). Testnet only — Base Sepolia (eip155:84532). Names follow SPEC §16.

# AI (fill at the AWS Toolbox)
AWS_REGION=
MODEL_MAIN=anthropic.claude-opus-5-5     # if no access: anthropic.claude-opus-4-8
MODEL_FAST=anthropic.claude-haiku-5-5    # if no access: anthropic.claude-haiku-4-5 (send no output_config.effort)
MOCK=1                      # 1 = scripted LLM replies (offline dev / stage fallback)

# Mandate
CZK_PER_EUR_DEMO=25         # tCZK -> EUR for mandate limits; shown on screen as a demo rate

# Validation runs (scripts/scenarios.py only)
SCENARIO_PRICE_EUR=0.10     # small amounts for the testnet scenario matrix
FAULTS=                     # comma list: settle_fail_once,registry_timeout,llm_bad_json,webhook_duplicate,webhook_bad_hmac

# Chain
RPC_URL=https://base-sepolia.gateway.tatum.io      # header x-api-key = TATUM_API_KEY; public fallback https://sepolia.base.org
TATUM_API_KEY=
TATUM_HMAC_SECRET=
PUBLIC_BASE_URL=            # https://<tunnel> for Tatum webhooks

# Keys (throwaway testnet; copy from prep spikes .env, never commit)
BANK_RELAYER_PK=            # = prep BANK_KEY   (0xD23DB197CC1294b049AeDf0d9ea1BA216691de48, has ETH)
BANK_ADMIN_PK=              # = prep BANK_KEY   (deployer/admin of tCZK)
BANK_OPERATOR_PK=           # = prep OPERATOR_KEY (0x0469ceC178789072bc61435835D0BB38214D4e53, has ETH)
ALFA_PK=                    # = prep BUYER_KEY  (0x491BeCCB4E26E1c5781E1E44c48Ad474D04d2140: USDC, EURC, prep tCZK)
BETA_ADDR=0x70E8B0ed46DC4FD558ee05bCEba06e5AAf00EBd1
GAMA_ADDR=                  # generate
DELTA_ADDR=                 # generate

# Contracts / tokens
EURC=0x808456652fdb597867f38412077A9182bf77359F
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
TCZK=                       # new TCZK after T3; stage fallback: prep token 0x6a99C9e95DD220172d07D5f730f2e82B466D4B67
TCZK_NAME="tCZK Deposit Token"   # EIP-712 name, must match TCZK; prep token: "Demo Bank tCZK"
ESCROW=0xf96815976523E00e65Be8f34cA5e64b4f41EB19c
COLLECTOR=0x8612dfdc421f80336cd14E8EF9cb1E765dB5ab88
OPERATOR_TOKEN_STORE=0xd2b0C305F62427414e9624a2beD72a3792e15cf8

# Services
BANK_FACILITATOR_URL=http://localhost:8000/x402
PUBLIC_FACILITATOR_URL=https://x402.org/facilitator   # EURC fallback only
SELLER_URL=http://localhost:8001

# Data
APIFY_TOKEN=
APIFY_COMPANY_CHECK_ACTOR=collabse/company-check   # <apify-username>/company-check after `apify push`
MOSTLYRIGHT_API_KEY=        # how to get: ask at onboarding
